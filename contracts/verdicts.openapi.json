    "/aois/{aoi}/events": {
      "get": {
        "operationId": "event_aois__aoi__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "aoi",
            "required": true,
            "schema": {
              "title": "Aoi",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          },
          {
            "description": "Horas que dura el evento. Si se da, manda sobre event_type. Sin ninguno de los dos, 24 h.",
            "in": "query",
            "name": "persistence_hours",
            "required": false,
            "schema": {
              "default": 24,
              "description": "Horas que dura el evento. Si se da, manda sobre event_type. Sin ninguno de los dos, 24 h.",
              "maximum": 720,
              "minimum": 1,
              "title": "Persistence Hours",
              "type": "integer"
            }
          },
          {
            "description": "Tipo de evento: fija una persistencia supuesta (urban_storm 6 h, river_flood 72 h, wildfire 240 h).",
            "in": "query",
            "name": "event_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "urban_storm",
                    "river_flood",
                    "wildfire"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Tipo de evento: fija una persistencia supuesta (urban_storm 6 h, river_flood 72 h, wildfire 240 h).",
              "title": "Event Type"
            }
          },
          {
            "description": "Hora UTC de inicio del evento, HH:MM. Opcional.",
            "in": "query",
            "name": "time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Hora UTC de inicio del evento, HH:MM. Opcional.",
              "title": "Time"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "default": "es",
              "enum": [
                "es",
                "en"
              ],
              "title": "Lang",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventVerdict"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Event"
      }
    },
