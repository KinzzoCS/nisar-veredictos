        "required": [
          "platform",
          "acquired_at",
          "days_from_radar",
          "covers_aoi",
          "max_cloud_cover",
          "attribution",
          "tiles"
        ],
        "title": "OpticalScene",
        "type": "object"
      },
      "OpticalSide": {
        "properties": {
          "radar_acquired_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hora UTC de la pasada de radar. Si se conoce, antes y después se comparan al segundo; si es null, se compara por día UTC y una escena del mismo día cuenta en los dos lados.",
            "title": "Radar Acquired At"
          },
          "radar_date": {
            "format": "date",
            "title": "Radar Date",
            "type": "string"
          },
          "scene": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OpticalScene"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "description": "clear: cubre la zona con nubosidad <= max_cloud_cover. cloudy: la menos nublada que cubre la zona, por encima del límite. partial_coverage: ninguna cubre la zona entera. none_in_window: ninguna a search_days o menos. catalog_unavailable: catalog no respondió.",
            "enum": [
              "clear",
              "cloudy",
              "partial_coverage",
              "none_in_window",
              "catalog_unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "radar_date",
          "radar_acquired_at",
          "scene"
        ],
        "title": "OpticalSide",
        "type": "object"
      },
      "OpticalTileOut": {
        "properties": {
