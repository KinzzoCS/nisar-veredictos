          "latency_status": {
            "description": "Por qué hay o no hay latencia: dato real disponible, dato sintético, catalog sin respuesta, gránulo ausente del catálogo o gránulo sin fecha de publicación.",
            "enum": [
              "available",
              "synthetic",
              "catalog_unavailable",
              "granule_not_in_catalog",
              "not_published"
            ],
            "title": "Latency Status",
            "type": "string"
          },
          "publication_latency_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Horas entre la adquisición y published_at, tal como las da catalog. null si no se conoce.",
            "title": "Publication Latency Hours"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Fecha 'updated' de CMR en UTC: aproxima la publicación. null si no se conoce.",
            "title": "Published At"
          }
        },
        "required": [
          "date",
          "granule",
          "acquired_at",
          "published_at",
          "publication_latency_hours",
          "latency_status",
          "age_days"
        ],
        "title": "PassFreshness",
        "type": "object"
      },
      "PersistenceAssumption": {
        "properties": {
