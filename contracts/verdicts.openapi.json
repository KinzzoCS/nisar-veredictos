          "tile_url": {
            "description": "Plantilla XYZ por el gateway: TiTiler lee visual_url.",
            "title": "Tile Url",
            "type": "string"
          },
          "visual_url": {
            "description": "COG en color verdadero (TCI) en el bucket público de Sentinel-2.",
