{
  "components": {
    "schemas": {
      "EventVerdict": {
        "properties": {
          "aoi": {
            "title": "Aoi",
            "type": "string"
          },
          "assumption": {
            "$ref": "#/components/schemas/PersistenceAssumption"
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause"
          },
          "cause_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause Label"
          },
          "data_kind": {
            "enum": [
              "real",
              "synthetic"
            ],
            "title": "Data Kind",
            "type": "string"
          },
          "event_date": {
            "format": "date",
            "title": "Event Date",
            "type": "string"
          },
          "event_time": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hora UTC de inicio del evento, si se indicó. Sin ella, puede empezar en cualquier momento de su día.",
            "title": "Event Time"
          },
          "event_type": {
            "anyOf": [
              {
                "enum": [
                  "urban_storm",
                  "river_flood",
                  "wildfire"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Tipo de evento indicado en la consulta, si lo hay.",
            "title": "Event Type"
          },
          "next_pass": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Pass"
          },
          "next_pass_acquired_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Hora UTC de la siguiente pasada según la línea de tiempo de catalog. null si no se conoce (datos sintéticos o catalog sin respuesta): entonces se considera todo su día.",
            "title": "Next Pass Acquired At"
          },
          "persistence_hours": {
            "title": "Persistence Hours",
            "type": "integer"
          },
          "previous_pass": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Pass"
          },
          "state": {
            "description": "Responde otra pregunta que los pares: si alguna pasada cayó mientras duraba el evento, en horas UTC. observable exige que caiga dentro en todos los casos posibles y no afirma ningún cambio: hay que consultar el veredicto del par. not_observable lleva su causa; timing_uncertain si solo cae dentro en algunos casos.",
            "enum": [
              "observable",
              "not_observable"
            ],
            "title": "State",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          }
        },
        "required": [
          "aoi",
          "event_date",
          "event_time",
          "event_type",
          "persistence_hours",
          "assumption",
          "state",
          "cause",
          "cause_label",
          "previous_pass",
          "next_pass",
          "next_pass_acquired_at",
          "data_kind",
          "summary"
        ],
        "title": "EventVerdict",
        "type": "object"
      },
      "Evidence": {
        "properties": {
          "changed_fraction": {
            "title": "Changed Fraction",
            "type": "number"
          },
          "mean_change_hh_db": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
