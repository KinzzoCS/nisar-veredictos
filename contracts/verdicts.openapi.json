      "OpticalEvidence": {
        "properties": {
          "after": {
            "$ref": "#/components/schemas/OpticalSide",
            "description": "Escena más cercana a to_date que no es anterior a la pasada."
          },
          "before": {
            "$ref": "#/components/schemas/OpticalSide",
            "description": "Escena más cercana a from_date que no es posterior a la pasada."
          },
          "cloud_cover_basis": {
            "const": "tile",
            "default": "tile",
            "title": "Cloud Cover Basis",
            "type": "string"
          },
          "collection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Collection"
          },
          "data_kind": {
            "const": "real",
            "default": "real",
            "description": "Las escenas ópticas son siempre datos reales.",
            "title": "Data Kind",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "license_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Url"
          },
          "max_cloud_cover": {
            "description": "Nubosidad máxima por tesela, en %. Valor inicial sin calibrar.",
            "title": "Max Cloud Cover",
            "type": "number"
          },
          "search_days": {
            "description": "Días máximos entre la escena óptica y su fecha de radar.",
            "title": "Search Days",
            "type": "integer"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Buscador de escenas usado por catalog. null si no respondió.",
            "title": "Source"
          },
          "text": {
            "description": "Resumen en el idioma pedido de qué escenas hay y con cuántas nubes.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "source",
          "collection",
          "license",
          "license_url",
          "max_cloud_cover",
          "search_days",
          "before",
          "after",
          "text"
        ],
        "title": "OpticalEvidence",
        "type": "object"
      },
      "OpticalScene": {
        "properties": {
          "acquired_at": {
            "description": "Hora UTC de la primera tesela de la adquisición.",
            "format": "date-time",
            "title": "Acquired At",
            "type": "string"
          },
          "attribution": {
            "description": "Texto de atribución que debe mostrarse junto a la imagen.",
            "title": "Attribution",
            "type": "string"
          },
          "covers_aoi": {
            "description": "Las teselas juntas cubren toda la zona.",
            "title": "Covers Aoi",
            "type": "boolean"
          },
          "days_from_radar": {
            "description": "Días respecto a radar_date; negativo si es anterior.",
            "title": "Days From Radar",
            "type": "integer"
          },
          "max_cloud_cover": {
            "description": "Mayor nubosidad entre sus teselas. Es de la tesela, no de la zona.",
            "title": "Max Cloud Cover",
            "type": "number"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          },
          "tiles": {
            "items": {
              "$ref": "#/components/schemas/OpticalTileOut"
            },
            "title": "Tiles",
            "type": "array"
          }
