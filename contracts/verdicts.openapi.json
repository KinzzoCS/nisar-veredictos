              "event_type",
              "user",
              "default"
            ],
            "title": "Source",
            "type": "string"
          },
          "text": {
            "description": "El supuesto redactado en el idioma pedido; también va en summary.does_not_prove.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "persistence_hours",
          "source",
          "event_type",
          "calibrated",
          "hours_by_event_type",
