          "pixel_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Pixel Counts",
            "type": "object"
          },
          "signature_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Signature Counts",
            "type": "object"
          },
          "threshold_hh_db": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Hh Db"
          },
          "threshold_hv_db": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Hv Db"
          }
        },
        "required": [
          "observed_fraction",
          "changed_fraction",
          "threshold_hh_db",
          "threshold_hv_db",
          "mean_change_hh_db",
          "mean_change_hv_db",
          "pixel_counts",
          "signature_counts",
          "optical"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Freshness": {
        "properties": {
          "after": {
            "$ref": "#/components/schemas/PassFreshness"
          },
          "before": {
            "$ref": "#/components/schemas/PassFreshness"
          },
