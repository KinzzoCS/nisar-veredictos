            "const": "cmr_updated",
            "default": "cmr_updated",
            "title": "Published At Basis",
            "type": "string"
          },
          "reference_date": {
            "description": "Fecha UTC con la que se calcula age_days (hoy, al responder).",
            "format": "date",
            "title": "Reference Date",
            "type": "string"
          }
        },
        "required": [
          "reference_date",
          "before",
          "after"
        ],
        "title": "Freshness",
        "type": "object"
      },
