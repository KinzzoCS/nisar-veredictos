      "ObservationPlan": {
        "properties": {
          "checked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cuándo consultó ingest el plan, en UTC.",
            "title": "Checked At"
          },
          "config_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "LSAR_CONFIG_ID de la observación planificada.",
            "title": "Config Id"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Título del gránulo de NISAR_COP que se usó, con su versión.",
            "title": "Plan"
          },
          "same_config": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "La configuración coincide con la del plan de la última pasada adquirida. null si falta alguna.",
            "title": "Same Config"
          },
          "status": {
            "description": "Qué dice el plan diario de NISAR (NISAR_COP) para la hora estimada. planned: una observación L-SAR cubre de 10 s antes a 40 s después. partial: la cubre solo en parte. not_planned: hay plan y no la cubre. no_plan: no hay plan publicado para esa hora. unknown: catalog no tiene el resumen de `ingest plan` o no coincide con esta pasada. Un plan no garantiza la adquisición: en el hueco de 2026-07-27 a 2026-08-02 hubo planes y no se adquirió nada.",
            "enum": [
              "planned",
              "partial",
              "not_planned",
              "no_plan",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "plan",
          "config_id",
          "same_config",
          "checked_at"
        ],
        "title": "ObservationPlan",
        "type": "object"
      },
      "OperaAcquisition": {
        "properties": {
          "acquired_at": {
            "description": "time_start de CMR de la primera tesela de la pasada, en UTC.",
            "format": "date-time",
            "title": "Acquired At",
            "type": "string"
          },
          "covers_aoi": {
            "description": "Las cajas de sus teselas contienen la zona. No dice si hay datos válidos en toda ella.",
            "title": "Covers Aoi",
            "type": "boolean"
          },
          "days_from_date": {
            "description": "Días entre la fecha UTC de la pasada y la pedida; negativo si es anterior.",
            "title": "Days From Date",
            "type": "integer"
          },
          "platform": {
            "title": "Platform",
            "type": "string"
          },
          "tiles": {
            "items": {
              "$ref": "#/components/schemas/OperaTileOut"
            },
