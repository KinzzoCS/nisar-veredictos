      "OpticalTile": {
        "properties": {
          "acquired_at": {
            "format": "date-time",
            "title": "Acquired At",
            "type": "string"
          },
          "bbox": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Caja de los datos de la escena en WGS84, [oeste, sur, este, norte], tomada del item STAC de Earth Search: la de su huella de datos, no la del cuadrado MGRS completo, así que una escena de borde de franja tiene una caja menor. Como en STAC, si cruza el antimeridiano el oeste es mayor que el este. Sirve como bounds de la fuente en el mapa, para no pedir teselas fuera de los datos. null si Earth Search no la da.",
            "title": "Bbox"
          },
          "cloud_cover": {
            "description": "Porcentaje de nubes de la tesela completa, no de la zona.",
            "title": "Cloud Cover",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "tile": {
            "description": "Tesela MGRS de unos 110 km de lado.",
            "title": "Tile",
            "type": "string"
          },
          "visual_url": {
            "description": "COG en color verdadero (TCI), legible por HTTPS sin cuenta.",
            "title": "Visual Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tile",
          "acquired_at",
          "cloud_cover",
          "visual_url"
        ],
