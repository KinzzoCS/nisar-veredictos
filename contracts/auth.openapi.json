{
  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "email": {
            "description": "Correo de la cuenta. Se guarda en minúsculas y no se verifica.",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Mínimo 12 caracteres, sin reglas de composición (RF-ACC-04).",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Jwk": {
        "properties": {
          "alg": {
            "const": "EdDSA",
            "title": "Alg",
            "type": "string"
          },
          "crv": {
            "const": "Ed25519",
            "title": "Crv",
            "type": "string"
          },
          "kid": {
            "title": "Kid",
            "type": "string"
          },
          "kty": {
            "const": "OKP",
            "title": "Kty",
            "type": "string"
          },
          "use": {
            "const": "sig",
            "title": "Use",
            "type": "string"
          },
          "x": {
            "title": "X",
            "type": "string"
          }
        },
        "required": [
          "kty",
          "crv",
          "x",
          "kid",
          "alg",
          "use"
        ],
        "title": "Jwk",
        "type": "object"
      },
      "JwksOut": {
        "properties": {
          "keys": {
            "items": {
              "$ref": "#/components/schemas/Jwk"
            },
            "title": "Keys",
            "type": "array"
          }
        },
        "required": [
          "keys"
        ],
        "title": "JwksOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "created_at": {
            "description": "Hora UTC de creación, ISO 8601.",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "const": false,
            "default": false,
            "description": "El correo no se verifica en esta versión: el perfil es declarado, no comprobado (constitución X.3).",
            "title": "Email Verified",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "student",
              "researcher"
            ],
            "title": "Role",
            "type": "string"
          },
          "sub": {
            "description": "Identificador de la cuenta (UUID).",
            "title": "Sub",
            "type": "string"
          }
        },
        "required": [
          "sub",
          "email",
          "role",
          "created_at"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "RegisterIn": {
        "properties": {
          "email": {
            "description": "Correo de la cuenta. Se guarda en minúsculas y no se verifica.",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Mínimo 12 caracteres, sin reglas de composición (RF-ACC-04).",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "description": "Perfil declarado por la persona; no se verifica (constitución X.3). `public` no necesita cuenta.",
            "enum": [
              "student",
              "researcher"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "role"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "description": "JWT EdDSA de 15 minutos. Se guarda en memoria, nunca en localStorage.",
            "title": "Access Token",
            "type": "string"
          },
          "email_verified": {
            "const": false,
            "default": false,
            "description": "El correo no se verifica en esta versión: el perfil es declarado, no comprobado (constitución X.3).",
            "title": "Email Verified",
            "type": "boolean"
          },
          "expires_in": {
            "description": "Segundos de vida del token de acceso.",
            "title": "Expires In",
            "type": "integer"
          },
          "role": {
            "enum": [
              "student",
              "researcher"
            ],
            "title": "Role",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in",
          "role"
        ],
        "title": "TokenOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Cuentas, sesiones y tokens de los perfiles. Ningún perfil cambia lo que dice un veredicto (constitución X.1): solo añade herramientas y cuotas.",
    "title": "NISAR auth",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "description": "Clave pública, por si un tercero quiere validar los tokens.",
        "operationId": "jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JwksOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Jwks"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/login": {
      "post": {
        "description": "Misma respuesta si el correo no existe o la contraseña no coincide (RF-ACC-04).",
        "operationId": "login_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Correo o contraseña incorrectos"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/logout": {
      "post": {
        "description": "Cierra la sesión de la cookie (toda su familia) y la borra.",
        "operationId": "logout_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout"
      }
    },
    "/me": {
      "get": {
        "operationId": "me_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sin token o token no válido"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Me"
      }
    },
    "/refresh": {
      "post": {
        "description": "Rota el token de la cookie. Reutilizar uno ya rotado cierra toda la sesión (RF-ACC-03).",
        "operationId": "refresh_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Sesión inexistente, caducada, cerrada o reutilizada"
          }
        },
        "summary": "Refresh"
      }
    },
    "/register": {
      "post": {
        "description": "Crea la cuenta y abre la sesión: devuelve el token de acceso y fija la cookie de renovación.",
        "operationId": "register_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register"
      }
    },
    "/verify": {
      "get": {
        "description": "Solo para el gateway (`auth_request`). Comprueba la firma en memoria, sin tocar la base de datos (RF-ACC-05 y 06).",
        "operationId": "verify_verify_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Token válido o sin token. Cabeceras X-Auth-Role (public, student o researcher) y X-Auth-Sub."
          },
          "401": {
            "description": "Token roto, caducado, con otra firma o de otra audiencia. Nunca se degrada a public."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify"
      }
    }
  }
}
